<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>바자회 계산기</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", sans-serif;
  background: #f5f5f7;
  color: #111;
  padding-bottom: 120px;
}

header {
  background: white;
  padding: 18px 16px 14px;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1px solid #ddd;
}

header h1 {
  margin: 0 0 4px;
  font-size: 23px;
}

header p {
  margin: 0;
  font-size: 13px;
  color: #777;
}

.container {
  padding: 14px;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.menu-btn {
  min-height: 88px;
  border: 1px solid #ddd;
  border-radius: 14px;
  background: white;
  padding: 9px 5px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  touch-action: manipulation;
}

.menu-btn:active {
  transform: scale(.96);
  background: #e9e9e9;
}

.menu-price {
  display: block;
  margin-top: 7px;
  font-size: 13px;
  color: #666;
  font-weight: 600;
}

.section {
  margin-top: 16px;
  background: white;
  border-radius: 16px;
  padding: 15px;
}

.section h2 {
  font-size: 18px;
  margin: 0 0 12px;
}

.empty {
  color: #999;
  text-align: center;
  padding: 18px 5px;
}

.cart-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #eee;
}

.cart-name {
  font-weight: 700;
  font-size: 15px;
}

.cart-sub {
  font-size: 13px;
  color: #777;
  margin-top: 3px;
}

.qty-box {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qty-btn {
  width: 35px;
  height: 35px;
  border: 0;
  border-radius: 10px;
  background: #ececec;
  font-size: 21px;
  font-weight: bold;
}

.qty-number {
  min-width: 24px;
  text-align: center;
  font-weight: 800;
}

.total-box {
  margin-top: 15px;
  padding-top: 14px;
  border-top: 2px solid #111;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label {
  font-size: 17px;
  font-weight: 700;
}

.total-price {
  font-size: 27px;
  font-weight: 900;
}

.pay-btn {
  width: 100%;
  margin-top: 13px;
  border: 0;
  border-radius: 14px;
  padding: 17px;
  background: #111;
  color: white;
  font-size: 18px;
  font-weight: 800;
}

.pay-btn:disabled {
  opacity: .3;
}

.cancel-btn {
  width: 100%;
  margin-top: 8px;
  border: 1px solid #ddd;
  border-radius: 12px;
  padding: 12px;
  background: white;
  font-weight: 700;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 12px;
}

.stat {
  background: #f3f3f3;
  border-radius: 12px;
  padding: 12px;
}

.stat-label {
  color: #777;
  font-size: 12px;
}

.stat-value {
  font-size: 19px;
  font-weight: 900;
  margin-top: 3px;
}

.history-item {
  border-bottom: 1px solid #eee;
  padding: 12px 0;
}

.history-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}

.history-price {
  font-weight: 900;
}

.history-time {
  font-size: 12px;
  color: #888;
  margin-top: 5px;
}

.history-menu {
  font-size: 13px;
  margin-top: 5px;
  line-height: 1.5;
}

.delete-sale {
  border: 0;
  background: #eee;
  border-radius: 8px;
  padding: 6px 9px;
  margin-top: 7px;
}

.settings-btn {
  width: 100%;
  border: 1px solid #ccc;
  background: white;
  border-radius: 12px;
  padding: 13px;
  font-size: 15px;
  font-weight: 700;
  margin-top: 8px;
}

.editor {
  display: none;
  margin-top: 12px;
}

.edit-row {
  display: grid;
  grid-template-columns: 1fr 100px;
  gap: 7px;
  margin-bottom: 8px;
}

.edit-row input {
  width: 100%;
  border: 1px solid #ccc;
  border-radius: 9px;
  padding: 10px 8px;
  font-size: 14px;
}

.save-btn {
  width: 100%;
  border: 0;
  border-radius: 12px;
  background: #111;
  color: white;
  padding: 13px;
  font-weight: 800;
}

.danger-btn {
  width: 100%;
  border: 0;
  border-radius: 12px;
  background: #eee;
  padding: 12px;
  margin-top: 8px;
  font-weight: 700;
}

.notice {
  font-size: 12px;
  color: #888;
  line-height: 1.5;
  margin-top: 10px;
}
</style>
</head>

<body>

<header>
  <h1>🧺 바자회 계산기</h1>
  <p>메뉴를 누르면 주문에 바로 추가됩니다.</p>
</header>

<div class="container">

  <div id="menuGrid" class="menu-grid"></div>

  <div class="section">
    <h2>🛒 현재 주문</h2>

    <div id="cart"></div>

    <div class="total-box">
      <span class="total-label">총 금액</span>
      <span id="totalPrice" class="total-price">0원</span>
    </div>

    <button id="payButton" class="pay-btn" onclick="completeSale()" disabled>
      결제 완료
    </button>

    <button class="cancel-btn" onclick="clearCart()">
      현재 주문 전체 취소
    </button>
  </div>


  <div class="section">
    <h2>📊 오늘 판매</h2>

    <div class="stats">
      <div class="stat">
        <div class="stat-label">결제 건수</div>
        <div id="saleCount" class="stat-value">0건</div>
      </div>

      <div class="stat">
        <div class="stat-label">총 매출</div>
        <div id="salesTotal" class="stat-value">0원</div>
      </div>
    </div>

    <div id="history"></div>
  </div>


  <div class="section">
    <h2>⚙️ 메뉴 / 가격 수정</h2>

    <button class="settings-btn" onclick="toggleEditor()">
      메뉴 수정 열기
    </button>

    <div id="editor" class="editor">
      <div id="editRows"></div>

      <button class="save-btn" onclick="saveMenu()">
        수정 내용 저장
      </button>

      <button class="danger-btn" onclick="resetMenu()">
        기본 메뉴로 되돌리기
      </button>
    </div>
  </div>


  <div class="section">
    <h2>💾 기록 관리</h2>

    <button class="settings-btn" onclick="downloadCSV()">
      판매 기록 CSV 저장
    </button>

    <button class="danger-btn" onclick="deleteAllHistory()">
      판매 기록 전체 삭제
    </button>

    <div class="notice">
      판매 기록과 수정한 메뉴는 이 기기의 브라우저에 저장됩니다.
      같은 아이폰에서 다시 접속하면 기록이 유지됩니다.
    </div>
  </div>

</div>


<script>
const DEFAULT_MENU = [
  {name:"수육", price:15000},
  {name:"오징어부추전", price:4000},
  {name:"삼치강정", price:5000},
  {name:"잔치국수", price:4000},
  {name:"비빔국수", price:4000},
  {name:"어묵 3개", price:2000},
  {name:"삼각김밥", price:2000},
  {name:"풋고추", price:2000},
  {name:"참기름", price:11000},
  {name:"통깨", price:5000},
  {name:"맛간장", price:13000}
];

let menu = loadJSON("bazaar_menu", DEFAULT_MENU);
let history = loadJSON("bazaar_history", []);
let cart = {};

function loadJSON(key, fallback) {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : JSON.parse(JSON.stringify(fallback));
  } catch(e) {
    return JSON.parse(JSON.stringify(fallback));
  }
}

function money(n) {
  return Number(n).toLocaleString("ko-KR") + "원";
}

function renderMenu() {
  const grid = document.getElementById("menuGrid");
  grid.innerHTML = "";

  menu.forEach((item, index) => {
    const button = document.createElement("button");
    button.className = "menu-btn";

    button.innerHTML =
      item.name +
      '<span class="menu-price">' +
      money(item.price) +
      '</span>';

    button.onclick = function() {
      addItem(index);
    };

    grid.appendChild(button);
  });
}

function addItem(index) {
  if (!cart[index]) {
    cart[index] = 0;
  }

  cart[index]++;
  renderCart();
}

function changeQty(index, amount) {
  if (!cart[index]) return;

  cart[index] += amount;

  if (cart[index] <= 0) {
    delete cart[index];
  }

  renderCart();
}

function renderCart() {
  const area = document.getElementById("cart");
  const indexes = Object.keys(cart);

  if (indexes.length === 0) {
    area.innerHTML =
      '<div class="empty">메뉴를 눌러 주문을 담아주세요.</div>';

    document.getElementById("totalPrice").textContent = "0원";
    document.getElementById("payButton").disabled = true;
    return;
  }

  area.innerHTML = "";

  let total = 0;

  indexes.forEach(key => {
    const index = Number(key);
    const qty = cart[index];
    const item = menu[index];

    if (!item) return;

    const subtotal = item.price * qty;
    total += subtotal;

    const row = document.createElement("div");
    row.className = "cart-row";

    row.innerHTML = `
      <div>
        <div class="cart-name">${escapeHTML(item.name)}</div>
        <div class="cart-sub">${money(item.price)} × ${qty} = ${money(subtotal)}</div>
      </div>

      <div class="qty-box">
        <button class="qty-btn" onclick="changeQty(${index}, -1)">−</button>
        <span class="qty-number">${qty}</span>
        <button class="qty-btn" onclick="changeQty(${index}, 1)">+</button>
      </div>
    `;

    area.appendChild(row);
  });

  document.getElementById("totalPrice").textContent = money(total);
  document.getElementById("payButton").disabled = false;
}

function getCartTotal() {
  let total = 0;

  Object.keys(cart).forEach(key => {
    const index = Number(key);

    if (menu[index]) {
      total += menu[index].price * cart[index];
    }
  });

  return total;
}

function completeSale() {
  const indexes = Object.keys(cart);

  if (indexes.length === 0) return;

  const saleItems = indexes.map(key => {
    const index = Number(key);

    return {
      name: menu[index].name,
      price: menu[index].price,
      qty: cart[index],
      subtotal: menu[index].price * cart[index]
    };
  });

  const sale = {
    id: Date.now(),
    time: new Date().toISOString(),
    total: getCartTotal(),
    items: saleItems
  };

  history.unshift(sale);

  localStorage.setItem(
    "bazaar_history",
    JSON.stringify(history)
  );

  cart = {};

  renderCart();
  renderHistory();

  alert("결제 완료!\\n" + money(sale.total));
}

function clearCart() {
  if (Object.keys(cart).length === 0) return;

  if (confirm("현재 주문을 모두 취소할까요?")) {
    cart = {};
    renderCart();
  }
}

function renderHistory() {
  const area = document.getElementById("history");

  const total = history.reduce(
    (sum, sale) => sum + Number(sale.total),
    0
  );

  document.getElementById("saleCount").textContent =
    history.length + "건";

  document.getElementById("salesTotal").textContent =
    money(total);

  if (history.length === 0) {
    area.innerHTML =
      '<div class="empty">아직 판매 기록이 없습니다.</div>';
    return;
  }

  area.innerHTML = "";

  history.forEach(sale => {
    const div = document.createElement("div");
    div.className = "history-item";

    const date = new Date(sale.time);

    const timeText =
      date.toLocaleDateString("ko-KR") +
      " " +
      date.toLocaleTimeString("ko-KR", {
        hour:"2-digit",
        minute:"2-digit",
        second:"2-digit"
      });

    const menuText = sale.items
      .map(item => `${escapeHTML(item.name)} × ${item.qty}`)
      .join(" / ");

    div.innerHTML = `
      <div class="history-top">
        <strong>결제</strong>
        <span class="history-price">${money(sale.total)}</span>
      </div>

      <div class="history-menu">${menuText}</div>
      <div class="history-time">${timeText}</div>

      <button
        class="delete-sale"
        onclick="deleteSale(${sale.id})">
        기록 삭제
      </button>
    `;

    area.appendChild(div);
  });
}

function deleteSale(id) {
  if (!confirm("이 판매 기록을 삭제할까요?")) return;

  history = history.filter(
    sale => sale.id !== id
  );

  localStorage.setItem(
    "bazaar_history",
    JSON.stringify(history)
  );

  renderHistory();
}

function deleteAllHistory() {
  if (history.length === 0) return;

  if (!confirm("판매 기록을 전부 삭제할까요?")) return;

  if (!confirm("정말 전체 삭제할까요? 복구할 수 없습니다.")) return;

  history = [];

  localStorage.setItem(
    "bazaar_history",
    JSON.stringify(history)
  );

  renderHistory();
}

function toggleEditor() {
  const editor = document.getElementById("editor");

  if (editor.style.display === "block") {
    editor.style.display = "none";
  } else {
    renderEditor();
    editor.style.display = "block";
  }
}

function renderEditor() {
  const area = document.getElementById("editRows");
  area.innerHTML = "";

  menu.forEach((item, index) => {
    const row = document.createElement("div");
    row.className = "edit-row";

    row.innerHTML = `
      <input
        id="name_${index}"
        type="text"
        value="${escapeAttribute(item.name)}">

      <input
        id="price_${index}"
        type="number"
        inputmode="numeric"
        value="${item.price}">
    `;

    area.appendChild(row);
  });
}

function saveMenu() {
  const newMenu = [];

  for (let i = 0; i < menu.length; i++) {
    const name =
      document.getElementById("name_" + i).value.trim();

    const price =
      Number(document.getElementById("price_" + i).value);

    if (!name || price < 0 || isNaN(price)) {
      alert("메뉴명과 가격을 확인해주세요.");
      return;
    }

    newMenu.push({
      name: name,
      price: price
    });
  }

  menu = newMenu;

  localStorage.setItem(
    "bazaar_menu",
    JSON.stringify(menu)
  );

  cart = {};

  renderMenu();
  renderCart();

  alert("메뉴와 가격을 저장했습니다.");
}

function resetMenu() {
  if (!confirm("처음 메뉴와 가격으로 되돌릴까요?")) return;

  menu = JSON.parse(
    JSON.stringify(DEFAULT_MENU)
  );

  localStorage.setItem(
    "bazaar_menu",
    JSON.stringify(menu)
  );

  cart = {};

  renderMenu();
  renderCart();
  renderEditor();

  alert("기본 메뉴로 되돌렸습니다.");
}

function downloadCSV() {
  if (history.length === 0) {
    alert("저장할 판매 기록이 없습니다.");
    return;
  }

  let rows = [
    ["시간", "메뉴", "수량", "단가", "금액"]
  ];

  history
    .slice()
    .reverse()
    .forEach(sale => {

      sale.items.forEach(item => {
        rows.push([
          new Date(sale.time).toLocaleString("ko-KR"),
          item.name,
          item.qty,
          item.price,
          item.subtotal
        ]);
      });

    });

  const csv =
    "\\uFEFF" +
    rows.map(row =>
      row.map(value =>
        '"' +
        String(value).replace(/"/g, '""') +
        '"'
      ).join(",")
    ).join("\\n");

  const blob = new Blob(
    [csv],
    {type:"text/csv;charset=utf-8;"}
  );

  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = "바자회_판매기록.csv";

  document.body.appendChild(link);
  link.click();
  link.remove();

  URL.revokeObjectURL(url);
}

function escapeHTML(text) {
  return String(text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function escapeAttribute(text) {
  return escapeHTML(text)
    .replace(/'/g, "&#39;");
}

renderMenu();
renderCart();
renderHistory();
</script>

</body>
</html>
